{{> head}}
<div class="min-h-screen flex" style="background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 50%,#0f172a 100%)">

  <!-- Left branding panel -->
  <div class="hidden lg:flex flex-col justify-center items-center w-2/5 px-12 text-white">
    <img src="/bjmp.jpg" alt="Bansud District Jail Logo" class="w-36 h-36 object-contain rounded-full mb-6" style="background:white;padding:8px;border:3px solid rgba(255,255,255,0.2)">
    <h1 class="text-3xl font-extrabold text-center leading-tight mb-3">Bansud District Jail</h1>
    <p class="text-blue-300 text-sm text-center leading-relaxed max-w-xs">
      Jail Warden Management System<br>
      <span style="color:rgba(255,255,255,0.4);font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase">Unity · Humility · Charity · Service</span>
    </p>
    <div class="mt-10 flex flex-col gap-3 w-full max-w-xs">
      <div class="flex items-center gap-3 text-xs text-blue-300" style="background:rgba(255,255,255,0.05);padding:0.75rem 1rem;border-radius:0.6rem">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Secure & Encrypted Access
      </div>
      <div class="flex items-center gap-3 text-xs text-blue-300" style="background:rgba(255,255,255,0.05);padding:0.75rem 1rem;border-radius:0.6rem">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Authorized Personnel Only
      </div>
    </div>
  </div>

  <!-- Right login form -->
  <div class="flex flex-1 items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="lg:hidden text-center mb-8">
        <img src="/bjmp.jpg" alt="Bansud District Jail Logo" class="w-20 h-20 object-contain rounded-full mx-auto mb-4" style="background:white;padding:6px;border:2px solid rgba(255,255,255,0.2)">
        <h1 class="text-2xl font-extrabold text-white">Bansud District Jail</h1>
        <p class="text-blue-300 text-sm mt-1">Warden Management Portal</p>
      </div>

      <div style="background:white;border-radius:1.25rem;padding:2.5rem;box-shadow:0 25px 60px rgba(0,0,0,0.4)">
        <div class="mb-6">
          <h2 style="font-size:1.35rem;font-weight:800;color:#0f172a;margin-bottom:0.25rem">Welcome back</h2>
          <p style="font-size:0.82rem;color:#64748b">Sign in to access the management portal</p>
        </div>

        {{#if error}}
          <div class="notice-error mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div>{{#each error}}{{this}}{{/each}}</div>
          </div>
        {{/if}}

        <form method="POST" action="/login" class="space-y-4">
          <div>
            <label class="field-label">Email Address</label>
            <input class="field" type="email" name="email" required autocomplete="username" placeholder="your@email.com">
          </div>
          <div>
            <label class="field-label">Password</label>
            <input class="field" type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
          </div>
          <div style="padding-top:0.5rem">
            <button class="btn-primary w-full" style="padding:0.75rem;font-size:0.9rem">
              Sign in to Portal
            </button>
          </div>
        </form>

        <p style="font-size:0.7rem;text-align:center;color:#94a3b8;margin-top:1.5rem;line-height:1.5">
          This system is for authorized BJMP personnel only.<br>
          Unauthorized access is a criminal offense.
        </p>
      </div>

      <p style="text-align:center;color:rgba(255,255,255,0.2);font-size:0.65rem;margin-top:1.25rem;letter-spacing:0.06em">
        BANSUD DISTRICT JAIL · BJMP MIMAROPA · EST. 1992
      </p>
    </div>
  </div>
</div>
{{> foot}}

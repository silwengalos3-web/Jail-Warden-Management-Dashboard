{{> shell-top}}

<div class="page-header">
  <div>
    <div class="page-title">Facility Overview</div>
    <div class="page-subtitle">Current operational summary and items requiring attention.</div>
  </div>
</div>

<div class="grid sm:grid-cols-2 xl:grid-cols-5 gap-4 mb-6">
  <div class="stat-card">
    <div class="stat-label">Total PDLs</div>
    <div class="stat-value">{{totalPDLs}}</div>
    <div class="stat-note">All registered records</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Active PDLs</div>
    <div class="stat-value">{{activePDLs}}</div>
    <div class="stat-note">Currently in facility</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pending Transfers</div>
    <div class="stat-value">{{pendingTransfers}}</div>
    <div class="stat-note">Awaiting Warden decision</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Open Incidents</div>
    <div class="stat-value">{{openIncidents}}</div>
    <div class="stat-note">Reported or under review</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Released PDLs</div>
    <div class="stat-value">{{releasedPDLs}}</div>
    <div class="stat-note">Marked as released</div>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-4 mb-6">
  <div class="panel lg:col-span-2">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Facility Occupancy
    </h2>
    <div class="flex justify-between text-sm mb-3" style="color:#475569">
      <span><strong style="color:#0f172a">{{activePDLs}}</strong> active PDLs</span>
      <span><strong style="color:#0f172a">{{occupancy}}%</strong> of {{capacity}} capacity</span>
    </div>
    <div class="occ-bar-bg">
      <div class="occ-bar-fill" style="width:{{occupancy}}%"></div>
    </div>
    <p style="font-size:0.72rem;color:#94a3b8;margin-top:0.75rem">Capacity is configurable through the FACILITY_CAPACITY environment variable.</p>
  </div>

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      Quick Actions
    </h2>
    <div class="grid gap-2">
      <a class="btn-primary" href="/pdls/new">+ Add PDL Record</a>
      <a class="btn-secondary" href="/transfers/new">+ Create Transfer Request</a>
      <a class="btn-secondary" href="/incidents/new">+ Record Incident</a>
    </div>
  </div>
</div>

<div class="grid xl:grid-cols-2 gap-4">
  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      Pending Transfer Requests
    </h2>
    {{#if recentTransfers.length}}
    <div class="table-wrap">
      <table>
        <thead><tr><th>PDL</th><th>Destination</th><th>Requested</th></tr></thead>
        <tbody>
          {{#each recentTransfers}}
          <tr>
            <td><span style="font-weight:600">{{PDL.pdlNumber}}</span><br><span style="color:#64748b;font-size:0.78rem">{{PDL.firstName}} {{PDL.lastName}}</span></td>
            <td>{{destinationFacility}}</td>
            <td>{{formatDate requestDate}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty">No pending transfers.</div>
    {{/if}}
  </div>

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      Recent Incidents
    </h2>
    {{#if recentIncidents.length}}
    <div class="table-wrap">
      <table>
        <thead><tr><th>Reference</th><th>Incident</th><th>Status</th></tr></thead>
        <tbody>
          {{#each recentIncidents}}
          <tr>
            <td style="font-size:0.75rem;color:#64748b">{{referenceNumber}}</td>
            <td style="font-weight:500">{{title}}</td>
            <td><span class="status">{{status}}</span></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="empty">No incident reports.</div>
    {{/if}}
  </div>
</div>

{{> shell-bottom}}

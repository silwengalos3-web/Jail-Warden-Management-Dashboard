{{> shell-top}}

<div class="page-header">
  <div>
    <div class="page-title">PDL Records</div>
    <div class="page-subtitle">View and manage persons deprived of liberty records.</div>
  </div>
  <a href="/pdls/new" class="btn-primary">+ Add PDL</a>
</div>

<div class="panel mb-4" style="padding:1rem">
  <form class="flex gap-2" method="GET">
    <input class="field max-w-sm" name="q" value="{{q}}" placeholder="Search by PDL number or name…">
    <button class="btn-secondary">Search</button>
    {{#if q}}<a href="/pdls" class="btn-secondary">Clear</a>{{/if}}
  </form>
</div>

<div class="panel">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>PDL Number</th>
          <th>Name</th>
          <th>Admission Date</th>
          <th>Cell</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each pdls}}
        <tr>
          <td style="font-weight:700;color:#1d4ed8">{{pdlNumber}}</td>
          <td style="font-weight:500">{{firstName}} {{lastName}}</td>
          <td>{{formatDate admissionDate}}</td>
          <td>{{assignedCell}}</td>
          <td><span class="status">{{status}}</span></td>
          <td><a class="link" href="/pdls/{{id}}">View →</a></td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="empty">No PDL records found.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

{{> shell-bottom}}

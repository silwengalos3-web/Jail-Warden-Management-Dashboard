{{> shell-top}}

<div class="page-header">
  <div>
    <div class="page-title">Reports & Analytics</div>
    <div class="page-subtitle">Management summaries for review and Regional Office reporting.</div>
  </div>
  <button onclick="window.print()" class="btn-primary">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
    Print / Save as PDF
  </button>
</div>

<div class="grid md:grid-cols-2 gap-4">

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      PDL Population Summary
    </h2>
    {{#each pdlStatus}}
    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.7rem 0;border-bottom:1px solid #f1f5f9;font-size:0.85rem">
      <span style="color:#475569">{{status}}</span>
      <strong style="color:#0f172a;font-size:1rem">{{total}}</strong>
    </div>
    {{/each}}
  </div>

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      Transfer Summary
    </h2>
    {{#each transferStatus}}
    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.7rem 0;border-bottom:1px solid #f1f5f9;font-size:0.85rem">
      <span style="color:#475569">{{status}}</span>
      <strong style="color:#0f172a;font-size:1rem">{{total}}</strong>
    </div>
    {{/each}}
  </div>

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      Incident Summary
    </h2>
    {{#each incidentStatus}}
    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.7rem 0;border-bottom:1px solid #f1f5f9;font-size:0.85rem">
      <span style="color:#475569">{{status}}</span>
      <strong style="color:#0f172a;font-size:1rem">{{total}}</strong>
    </div>
    {{/each}}
  </div>

  <div class="panel">
    <h2 class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Current Month Activity
    </h2>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.7rem 0;border-bottom:1px solid #f1f5f9;font-size:0.85rem">
      <span style="color:#475569">New admissions</span>
      <strong style="color:#0f172a;font-size:1rem">{{recentAdmissions}}</strong>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.7rem 0;font-size:0.85rem">
      <span style="color:#475569">Released this month</span>
      <strong style="color:#0f172a;font-size:1rem">{{recentReleases}}</strong>
    </div>
  </div>

</div>

<p style="font-size:0.72rem;color:#94a3b8;margin-top:1.25rem">
  Generated: {{generatedAt}} &nbsp;·&nbsp; This summary should be verified against official source records before submission.
</p>

{{> shell-bottom}}

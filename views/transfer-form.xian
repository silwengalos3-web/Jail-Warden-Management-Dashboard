{{> shell-top}}
<div class="panel max-w-2xl"><h1 class="text-xl font-bold mb-5">Create Transfer Request</h1>
<form method="POST" action="/transfers" class="space-y-4">
<div><label class="field-label">Active PDL *</label><select class="field" name="PDLId" required><option value="">Select PDL</option>{{#each pdls}}<option value="{{id}}">{{pdlNumber}} — {{firstName}} {{lastName}}</option>{{/each}}</select></div>
<div><label class="field-label">Destination Facility *</label><input class="field" name="destinationFacility" required></div>
<div><label class="field-label">Reason for Transfer *</label><textarea class="field" name="transferReason" rows="4" required></textarea></div>
<div class="flex gap-2"><button class="btn-primary">Submit Request</button><a href="/transfers" class="btn-secondary">Cancel</a></div>
</form></div>{{> shell-bottom}}
